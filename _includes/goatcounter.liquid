{% if jekyll.environment == 'production' and site.goatcounter_code != blank %}
  <script
    {% if site.enable_cookie_consent %}
      type="text/plain" data-category="analytics"
    {% endif %}
    data-goatcounter="https://{{ site.goatcounter_code | escape }}.goatcounter.com/count"
    async
    src="https://gc.zgo.at/count.js"
  ></script>
{% endif %}
